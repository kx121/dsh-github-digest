{
  "name": "dsh-github-digest",
  "version": "0.2.2",
  "license": "MIT",
  "description": "到点叫醒 DSH 会话，翻你关注的 GitHub 仓库和主题，挑出值得跟的变化，写日报、记判重表。只读。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kx121/dsh-github-digest.git"
  },
  "homepage": "https://github.com/kx121/dsh-github-digest#readme",
  "bugs": {
    "url": "https://github.com/kx121/dsh-github-digest/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "schedule",
    "digest",
    "automation"
  ],
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "prompts",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "tools",
    "README.md",
    "CHANGELOG.md",
    "RELEASING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "test": "node tools/smoke-test.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
